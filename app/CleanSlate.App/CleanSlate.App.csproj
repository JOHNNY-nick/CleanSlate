<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>CleanSlate.App</RootNamespace>
    <!-- Not "CleanSlate": CleanSlate.dll would clash with the native cleanslate.dll. -->
    <AssemblyName>CleanSlate.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\branding\cleanslate.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged app: requireAdministrator is not allowed in a packaged app. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultLanguage>fr-FR</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <!-- Window and taskbar icon, loaded by MainWindow through AppWindow.SetIcon. -->
  <ItemGroup>
    <Content Include="..\..\assets\branding\cleanslate.ico" Link="Assets\cleanslate.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Unpackaged publish leaves out the compiled XAML (*.xbf) and the app's
       resources.pri; without them the app crashes at startup (J6, D41). -->
  <Target Name="PublishXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <XamlPublishFiles Include="$(OutDir)**\*.xbf;$(OutDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(XamlPublishFiles)"
          DestinationFiles="@(XamlPublishFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\CleanSlate.Interop\CleanSlate.Interop.csproj" />
    <ProjectReference Include="..\CleanSlate.Presentation\CleanSlate.Presentation.csproj" />
  </ItemGroup>

</Project>
