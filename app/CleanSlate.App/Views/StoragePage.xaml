<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanSlate.App.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CleanSlate.App.Converters"
    xmlns:vm="using:CleanSlate.Presentation.ViewModels"
    Loaded="OnLoaded">

    <Page.Resources>
        <conv:ResourceStringConverter x:Key="ResourceString" />
    </Page.Resources>

    <!-- « Stockage » (D69): disks, quarantine, space freed, free space around each action. -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource PageHeaderBorderStyle}" Background="{ThemeResource PageHeaderStorageBrush}">
                <TextBlock x:Uid="StorageTitle" Style="{StaticResource PageHeaderTextBlockStyle}" />
            </Border>
            <TextBlock x:Uid="StorageIntro" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="StorageDrivesTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Drives}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:DriveRow">
                                <StackPanel Padding="0,4" Spacing="4">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <Run Text="  " />
                                        <Run Text="{x:Bind FreeText}" />
                                        <Run x:Uid="StorageFreeOf" />
                                        <Run Text="{x:Bind TotalText}" />
                                    </TextBlock>
                                    <ProgressBar Maximum="100" Value="{x:Bind UsedPercent}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="StorageHeldTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.QuarantineHeldText, Mode=OneWay}" />
                        <TextBlock x:Uid="StorageHeldHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="StorageFreedTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.FreedForGoodText, Mode=OneWay}" />
                        <TextBlock x:Uid="StorageFreedHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="StorageJournalTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="StorageJournalHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="StorageJournalEmpty" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Entries}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:StorageEntryRow">
                                <StackPanel Padding="0,6" Spacing="2">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold" Text="{x:Bind Operation, Converter={StaticResource ResourceString}, ConverterParameter=StorageOperation}" />
                                        <Run Text=" · " />
                                        <Run Text="{x:Bind Detail}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap">
                                        <Run Text="{x:Bind DateText}" />
                                        <Run Text=" · " />
                                        <Run Text="{x:Bind Drive}" />
                                        <Run Text=" · " />
                                        <Run x:Uid="StorageBefore" />
                                        <Run Text="{x:Bind BeforeText}" />
                                        <Run Text=" → " />
                                        <Run x:Uid="StorageAfter" />
                                        <Run Text="{x:Bind AfterText}" />
                                        <Run Text=" (" />
                                        <Run Text="{x:Bind DifferenceText}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
