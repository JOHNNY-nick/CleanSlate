<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanSlate.App.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CleanSlate.App.Converters"
    xmlns:vm="using:CleanSlate.Presentation.ViewModels"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Page.Resources>
        <conv:ResourceStringConverter x:Key="ResourceString" />
        <conv:StorageCategoryBrushConverter x:Key="CategoryBrush" />
    </Page.Resources>

    <!-- « Stockage » (D73): drive bars, then the map of what takes the space. Read-only. -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="16">
            <Border Style="{StaticResource PageHeaderBorderStyle}" Background="{ThemeResource PageHeaderStorageBrush}">
                <TextBlock x:Uid="StorageTitle" Style="{StaticResource PageHeaderTextBlockStyle}" />
            </Border>

            <!-- One bar per drive: used / free, with the figures. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Drives}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DriveBar">
                            <StackPanel Padding="0,4" Spacing="6">
                                <TextBlock Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <Run Text="  " />
                                    <Run Text="{x:Bind Text}" />
                                </TextBlock>
                                <ProgressBar Height="10" AutomationProperties.Name="{x:Bind Text}" Maximum="100" Value="{x:Bind UsedPercent}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>

            <!-- After a cleanup: one short line, never the detail of the calculation (it is in Historique). -->
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimaryBrush}"
                Text="{x:Bind ViewModel.LastCleanupText, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind conv:Texts.IsSet(ViewModel.LastCleanupText), Mode=OneWay}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="StorageMapTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextBlockStyle}" Text="{x:Bind ViewModel.LastComputedText, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Uid="StorageMapRefresh" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource MainButtonStyle}" />
                            <!-- The explanation of the map and of the list, in a « ? » (owner, 4 Nov. 2026). -->
                            <Button x:Uid="StorageHelp" Width="40" Height="40" Padding="0" CornerRadius="20">
                                <TextBlock FontSize="18" FontWeight="Bold" Text="?" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Width="400" Spacing="10">
                                            <TextBlock x:Uid="StorageHelpTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock x:Uid="StorageMapHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Uid="StorageMapCancel" Command="{x:Bind ViewModel.RefreshCancelCommand}" Visibility="{x:Bind ViewModel.IsComputing, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsComputing, Mode=OneWay}">
                        <ProgressBar IsIndeterminate="True" x:Uid="StorageMapProgress" />
                        <TextBlock Style="{StaticResource SecondaryTextBlockStyle}" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock x:Uid="StorageMapIntro" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ShowIntro, Mode=OneWay}" />
                    <InfoBar IsClosable="False" IsOpen="{x:Bind conv:Texts.HasText(ViewModel.ErrorText), Mode=OneWay}" Severity="Error" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />

                    <!-- Breadcrumb: back to any level above. -->
                    <ItemsRepeater x:Name="BreadcrumbList" ItemsSource="{x:Bind ViewModel.Breadcrumb}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:BreadcrumbItem">
                                <HyperlinkButton Click="OnBreadcrumb" Content="{x:Bind Name}" Tag="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- The treemap: drawn by the code-behind from ViewModel.Tiles (view logic only). -->
                    <Canvas
                        x:Name="MapCanvas"
                        Height="440"
                        HorizontalAlignment="Stretch"
                        x:Uid="StorageMapCanvas"
                        SizeChanged="OnMapSizeChanged"
                        Visibility="{x:Bind ViewModel.HasMap, Mode=OneWay}" />

                    <!-- Legend: every category by name and size, never by color only. -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Legend}" Visibility="{x:Bind ViewModel.HasMap, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="300" MinColumnSpacing="12" MinRowSpacing="6" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LegendItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Background="{x:Bind Category, Converter={StaticResource CategoryBrush}}" BorderBrush="{ThemeResource TextSecondaryBrush}" BorderThickness="1" CornerRadius="3" />
                                    <TextBlock Grid.Column="1" Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap">
                                        <Run Text="{x:Bind Category, Converter={StaticResource ResourceString}, ConverterParameter=StorageCategory}" />
                                        <Run Text=" · " />
                                        <Run FontWeight="SemiBold" Text="{x:Bind SizeText}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- D83: the folder shown by the map, as a list; the same clicks, and its files to delete. -->
            <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.HasMap, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="StorageExplorerTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock FontFamily="{StaticResource PathFontFamily}" Foreground="{ThemeResource TextPrimaryBrush}" Text="{x:Bind ViewModel.FolderText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.FolderText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SecondaryTextBlockStyle}" Text="{x:Bind ViewModel.ExplorerSummary, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Button x:Uid="StorageCheckAll" Command="{x:Bind ViewModel.CheckAllCommand}" />
                            <Button x:Uid="StorageUncheckAll" Command="{x:Bind ViewModel.UncheckAllCommand}" />
                            <Button x:Uid="StorageReveal" Command="{x:Bind ViewModel.RevealFolderCommand}" />
                            <Button x:Uid="StorageDelete" Command="{x:Bind ViewModel.DeleteCheckedCommand}" Style="{StaticResource DangerButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Uid="StorageExplorerHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    <InfoBar x:Uid="StorageApplication" IsClosable="False" IsOpen="{x:Bind ViewModel.IsApplicationFolder, Mode=OneWay}" Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button x:Uid="StorageOpenApps" Command="{x:Bind ViewModel.OpenAppsCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsListing, Mode=OneWay}" />
                    <InfoBar IsClosable="False" IsOpen="{x:Bind conv:Texts.HasText(ViewModel.ExplorerResult), Mode=OneWay}" Message="{x:Bind ViewModel.ExplorerResult, Mode=OneWay}" Severity="Informational" />
                    <ListView MaxHeight="560" IsItemClickEnabled="True" ItemClick="OnEntryClick" ItemsSource="{x:Bind ViewModel.Entries}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExplorerRow">
                                <Grid Padding="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox MinWidth="0" AutomationProperties.Name="{x:Bind Name}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                    <FontIcon Grid.Column="1" FontSize="18" Foreground="{ThemeResource TextPrimaryBrush}" Glyph="{x:Bind conv:Visible.Glyph(IsFolder)}" />
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}">
                                            <Run Text="{x:Bind TypeText}" />
                                            <Run Text="·" />
                                            <Run Text="{x:Bind DateText}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="3" Padding="8,2" VerticalAlignment="Center" Background="{ThemeResource ConfidenceMediumBackgroundBrush}" CornerRadius="4" Visibility="{x:Bind IsSensitive}">
                                        <TextBlock x:Uid="ManagerSensitiveBadge" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ConfidenceMediumForegroundBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" Text="{x:Bind SizeText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
