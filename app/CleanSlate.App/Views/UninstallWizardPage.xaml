<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanSlate.App.Views.UninstallWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CleanSlate.App.Converters"
    xmlns:vm="using:CleanSlate.Presentation.ViewModels">

    <Page.Resources>
        <conv:ResourceStringConverter x:Key="ResourceString" />
        <conv:ConfidenceBrushConverter x:Key="ConfidenceBrush" />
        <!--
            One line of the progress history (D57): clock, elapsed time and step, then the detail
            below. No Auto column: both lines wrap at any window width, nothing is cut.
        -->
        <DataTemplate x:Key="ProgressEntryTemplate" x:DataType="vm:UninstallProgressEntry">
            <StackPanel Padding="0,3" Spacing="1">
                <TextBlock FontSize="13" TextWrapping="Wrap">
                    <Run FontFamily="{StaticResource PathFontFamily}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind TimeText}" />
                    <Run Text="  " />
                    <Run FontFamily="{StaticResource PathFontFamily}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind ElapsedText}" />
                    <Run Text="  " />
                    <Run Foreground="{ThemeResource TextPrimaryBrush}" Text="{x:Bind StepKey, Converter={StaticResource ResourceString}, ConverterParameter=UninstallStep}" />
                </TextBlock>
                <TextBlock
                    Margin="16,0,0,0"
                    FontSize="13"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Text="{x:Bind Detail}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind HasDetail}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <!-- Vertical scrolling only: every line wraps to the window width. -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource TextPrimaryBrush}">
                    <Run x:Uid="WizardTitlePrefix" />
                    <Run Text="{x:Bind ViewModel.App.DisplayName, Mode=OneWay, FallbackValue=''}" />
                </TextBlock>
                <TextBlock Style="{StaticResource SecondaryTextBlockStyle}">
                    <Run x:Uid="WizardStep" />
                    <Run Text="{x:Bind ViewModel.Step, Mode=OneWay}" />
                    <Run x:Uid="WizardStepOf" />
                </TextBlock>
            </StackPanel>

            <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.ShowGenericError, Mode=OneWay}" Severity="Error" x:Uid="WizardError" Message="{x:Bind ViewModel.ErrorDetails, Mode=OneWay}" />
            <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.IsUninstallerMissing, Mode=OneWay}" Severity="Warning" x:Uid="WizardNoUninstaller">
                <InfoBar.ActionButton>
                    <Button x:Uid="WizardSearchAnyway" Command="{x:Bind ViewModel.SearchLeftoversAnywayCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Step 1: confirmation -->
            <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.IsStep1, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.App.DisplayName, Mode=OneWay, FallbackValue=''}" />
                    <TextBlock Style="{StaticResource SecondaryTextBlockStyle}">
                        <Run Text="{x:Bind ViewModel.App.PublisherText, Mode=OneWay, FallbackValue=''}" />
                        <Run Text="·" />
                        <Run Text="{x:Bind ViewModel.App.VersionText, Mode=OneWay, FallbackValue=''}" />
                        <Run Text="·" />
                        <Run Text="{x:Bind ViewModel.App.SizeText, Mode=OneWay, FallbackValue=''}" />
                    </TextBlock>
                    <!-- Important application (D65, D67): a plain notice, nothing to tick. -->
                    <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.HasCaution, Mode=OneWay}" Severity="Warning" x:Uid="WizardCaution" Message="{x:Bind ViewModel.CautionKey, Mode=OneWay, Converter={StaticResource ResourceString}, ConverterParameter=Caution}" />
                    <CheckBox x:Uid="WizardRestorePoint" IsChecked="{x:Bind ViewModel.CreateRestorePoint, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsWin32, Mode=OneWay}" />
                    <CheckBox x:Uid="WizardQuiet" IsChecked="{x:Bind ViewModel.Quiet, Mode=TwoWay}" Visibility="{x:Bind ViewModel.CanQuiet, Mode=OneWay}" />
                    <TextBlock x:Uid="WizardStep1Help" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    <Button x:Uid="WizardLaunch" Command="{x:Bind ViewModel.LaunchCommand}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- Step 2: waiting for the official uninstaller -->
            <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.IsStep2, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="WizardWaiting" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar
                            x:Uid="WizardWaitingBar"
                            VerticalAlignment="Center"
                            IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                            Maximum="100"
                            Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="{x:Bind conv:Texts.One('Format_Percent', ViewModel.ProgressPercent), Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsProgressKnown, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="2"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="{x:Bind conv:Texts.One('Format_Elapsed', ViewModel.ElapsedText), Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        Text="{x:Bind ViewModel.ActionText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasAction, Mode=OneWay}" />
                    <TextBlock x:Uid="WizardStepsTitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <ScrollViewer MaxHeight="240" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Uid="WizardStepsList" ItemsSource="{x:Bind ViewModel.History}" ItemTemplate="{StaticResource ProgressEntryTemplate}" />
                    </ScrollViewer>
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasProcesses, Mode=OneWay}">
                        <TextBlock x:Uid="WizardProcessesTitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <ItemsControl x:Uid="WizardProcessesList" FontFamily="{StaticResource PathFontFamily}" FontSize="12" ItemsSource="{x:Bind ViewModel.Processes}" />
                    </StackPanel>
                    <TextBlock x:Uid="WizardWaitingHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    <Button x:Uid="WizardStopWaiting" Command="{x:Bind ViewModel.LaunchCancelCommand}" />
                </StackPanel>
            </Border>

            <!-- Step 3: leftovers -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsStep3, Mode=OneWay}">
                <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.ShowUninstalledBanner, Mode=OneWay}" Severity="Success" x:Uid="WizardUninstalled" />
                <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.WithoutUninstaller, Mode=OneWay}" Severity="Warning" x:Uid="WizardLeftoversUnchecked" />
                <TextBlock x:Uid="WizardLeftoversTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:LeftoverGroupViewModel">
                            <ItemsRepeater ItemsSource="{x:Bind Items}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LeftoverItemViewModel">
                                        <Grid Padding="0,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox MinWidth="0" AutomationProperties.Name="{x:Bind AutomationName}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind Kind, Converter={StaticResource ResourceString}, ConverterParameter=Kind}" />
                                                <TextBlock FontFamily="{StaticResource PathFontFamily}" FontSize="13" Text="{x:Bind Location}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind ReasonsText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind SizeText}" />
                                            <Border Grid.Column="3" Padding="8,2" VerticalAlignment="Center" CornerRadius="4" Background="{x:Bind Confidence, Converter={StaticResource ConfidenceBrush}, ConverterParameter=Background}">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind Confidence, Converter={StaticResource ConfidenceBrush}, ConverterParameter=Foreground}" Text="{x:Bind Confidence, Converter={StaticResource ResourceString}, ConverterParameter=Confidence}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Uid="WizardSkipLeftovers" Command="{x:Bind ViewModel.SkipLeftoversCommand}" />
                    <Button Background="{ThemeResource DangerBrush}" Foreground="White" Command="{x:Bind ViewModel.QuarantineCommand}" Content="{x:Bind ViewModel.ActionKey, Mode=OneWay, Converter={StaticResource ResourceString}, ConverterParameter=Action}" />
                </StackPanel>
            </StackPanel>

            <!-- Step 4: summary -->
            <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.IsStep4, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="WizardDone" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Visibility="{x:Bind ViewModel.StillInstalled, Mode=OneWay}" x:Uid="WizardStillInstalled" TextWrapping="Wrap" />
                    <TextBlock Visibility="{x:Bind ViewModel.WithoutUninstaller, Mode=OneWay}" x:Uid="WizardEntryKept" TextWrapping="Wrap" />
                    <TextBlock Visibility="{x:Bind ViewModel.NoLeftoverFound, Mode=OneWay}" x:Uid="WizardNoLeftover" TextWrapping="Wrap" />
                    <!-- « la commande ci-dessous » : this line comes before the command. -->
                    <TextBlock Visibility="{x:Bind ViewModel.WasSimulated, Mode=OneWay}" x:Uid="WizardSimulatedDone" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ShowCommandLine, Mode=OneWay}">
                        <Run x:Uid="WizardCommand" />
                        <Run FontFamily="{StaticResource PathFontFamily}" Text="{x:Bind ViewModel.Result.Command, Mode=OneWay, FallbackValue=''}" />
                    </TextBlock>
                    <!-- « mis en quarantaine » or « supprimés définitivement » (D66). -->
                    <TextBlock
                        Text="{x:Bind conv:Texts.Two(ViewModel.CleanedFormatKey, ViewModel.CleanedCount, ViewModel.CleanedSizeText), Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowCleanedLine, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind conv:Texts.Two('Format_Simulation', ViewModel.CleanedCount, ViewModel.CleanedSizeText), Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowCleanSimulatedLine, Mode=OneWay}" />
                    <!-- What happened during the uninstall, even when it was too fast to follow (D57). -->
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay}">
                        <TextBlock x:Uid="WizardHistoryTitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock
                            Style="{StaticResource SecondaryTextBlockStyle}"
                            Text="{x:Bind conv:Texts.Two('Format_ProgressCounts', ViewModel.ProgressEventCount, ViewModel.DurationText), Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource SecondaryTextBlockStyle}"
                            Text="{x:Bind conv:Texts.Two('Format_ProgressSeen', ViewModel.MaxPercentText, ViewModel.ProcessNamesText), Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <ScrollViewer MaxHeight="260" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Uid="WizardHistoryList" ItemsSource="{x:Bind ViewModel.History}" ItemTemplate="{StaticResource ProgressEntryTemplate}" />
                        </ScrollViewer>
                    </StackPanel>
                    <HyperlinkButton x:Uid="WizardOpenHistory" Command="{x:Bind ViewModel.OpenHistoryCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
