<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanSlate.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="16">
            <TextBlock x:Uid="HomeTitle" Style="{StaticResource PageTitleTextBlockStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextPrimaryBrush}">
                        <Run x:Uid="HomeEngineLabel" />
                        <Run Text="{x:Bind ViewModel.EngineVersion, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Uid="HomeEngineCaption" Style="{StaticResource SecondaryTextBlockStyle}" />
                </StackPanel>
            </Border>

            <InfoBar
                x:Uid="HomeEngineError"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorDetails, Mode=OneWay}"
                Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
