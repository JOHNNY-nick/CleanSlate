<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanSlate.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CleanSlate.App.Converters"
    xmlns:vm="using:CleanSlate.Presentation.ViewModels"
    Loaded="OnLoaded">

    <Page.Resources>
        <conv:ResourceStringConverter x:Key="ResourceString" />
        <conv:StorageCategoryBrushConverter x:Key="CategoryBrush" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PageHeaderBorderStyle}" Background="{ThemeResource PageHeaderHomeBrush}">
                    <TextBlock x:Uid="HomeTitle" Style="{StaticResource PageHeaderTextBlockStyle}" />
                </Border>
                <Button x:Uid="HomeAnalyze" Grid.Column="1" VerticalAlignment="Top" Command="{x:Bind ViewModel.AnalyzeLeftoversCommand}" Style="{StaticResource MainButtonStyle}" />
            </Grid>

            <InfoBar x:Uid="HomeNeedsElevation" IsClosable="False" IsOpen="{x:Bind ViewModel.NeedsElevation}" Severity="Warning">
                <InfoBar.ActionButton>
                    <Button x:Uid="HomeRestartElevated" Click="OnRestartElevated" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Uid="HomeSpaceAlert" IsClosable="True" IsOpen="{x:Bind conv:Texts.HasText(ViewModel.AlertText), Mode=OneWay}" Message="{x:Bind ViewModel.AlertText, Mode=OneWay}" Severity="Warning">
                <InfoBar.ActionButton>
                    <Button x:Uid="HomeSpaceAlertFree" Command="{x:Bind ViewModel.OpenManagerCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Uid="HomeEngineError" IsClosable="False" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorDetails, Mode=OneWay}" Severity="Error" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="HomeAppsLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.AppCount, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="HomeLeftoversLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.RecoverableText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}">
                            <Run x:Uid="HomeLastScan" />
                            <Run Text="{x:Bind ViewModel.LastScanText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="HomeFreedLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.FreedText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Compact storage preview (D73): the system drive and its largest categories. -->
            <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.HasStorageDrive, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="HomeStorageTitle" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button x:Uid="HomeStorageOpen" Grid.Column="1" Command="{x:Bind ViewModel.OpenStorageCommand}" />
                    </Grid>
                    <TextBlock Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.StorageDrive.Name, Mode=OneWay}" />
                        <Run Text="  " />
                        <Run Text="{x:Bind ViewModel.StorageDrive.Text, Mode=OneWay}" />
                    </TextBlock>
                    <ProgressBar Height="10" AutomationProperties.Name="{x:Bind ViewModel.StorageDrive.Text, Mode=OneWay}" Maximum="100" Value="{x:Bind ViewModel.StorageDrive.UsedPercent, Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.StorageSummary}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="300" MinColumnSpacing="12" MinRowSpacing="4" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LegendItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" Background="{x:Bind Category, Converter={StaticResource CategoryBrush}}" BorderBrush="{ThemeResource TextSecondaryBrush}" BorderThickness="1" CornerRadius="3" />
                                    <TextBlock Grid.Column="1" Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap">
                                        <Run Text="{x:Bind Category, Converter={StaticResource ResourceString}, ConverterParameter=StorageCategory}" />
                                        <Run Text=" · " />
                                        <Run FontWeight="SemiBold" Text="{x:Bind SizeText}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Style="{StaticResource SecondaryTextBlockStyle}" Text="{x:Bind ViewModel.LastCleanupText, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind conv:Texts.IsSet(ViewModel.LastCleanupText), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="HomeRecentSessions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="HomeNoSession" Style="{StaticResource SecondaryTextBlockStyle}" Visibility="{x:Bind ViewModel.HasNoSession, Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecentSessions}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionViewModel">
                                <TextBlock Padding="0,4" Foreground="{ThemeResource TextPrimaryBrush}">
                                    <Run Text="{x:Bind DateText}" />
                                    <Run Text="·" />
                                    <Run Text="{x:Bind Session.Origin.Kind, Converter={StaticResource ResourceString}, ConverterParameter=Origin}" />
                                    <Run Text="·" />
                                    <Run Text="{x:Bind ItemCount}" />
                                    <Run x:Uid="HistoryItems" />
                                    <Run Text="·" />
                                    <Run Text="{x:Bind FreedText}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}">
                <Run x:Uid="HomeEngineLabel" />
                <Run Text="{x:Bind ViewModel.EngineVersion, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</Page>
