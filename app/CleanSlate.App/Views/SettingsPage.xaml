<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanSlate.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CleanSlate.App.Converters"
    Loaded="OnLoaded">

    <Page.Resources>
        <conv:ResourceStringConverter x:Key="ResourceString" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock x:Uid="SettingsTitle" Style="{StaticResource PageTitleTextBlockStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Uid="SettingsDeleteImmediately" IsOn="{x:Bind ViewModel.DeleteImmediately, Mode=TwoWay}" />
                    <TextBlock x:Uid="SettingsDeleteImmediatelyHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <NumberBox x:Uid="SettingsQuarantineDays" IsEnabled="{x:Bind ViewModel.KeepsQuarantine, Mode=OneWay}" Maximum="365" Minimum="1" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.QuarantineDays, Mode=TwoWay}" />
                    <TextBlock x:Uid="SettingsQuarantineHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Folders chosen at the first launch (D63). -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsFoldersTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsQuarantineFolderLabel" Style="{StaticResource SecondaryTextBlockStyle}" />
                    <TextBlock FontFamily="{StaticResource PathFontFamily}" FontSize="13" Text="{x:Bind ViewModel.QuarantineFolder, Mode=OneWay}" TextWrapping="Wrap" />
                    <Button x:Uid="SettingsQuarantineFolderChange" Command="{x:Bind ViewModel.ChangeQuarantineFolderCommand}" />
                    <TextBlock x:Uid="SettingsQuarantineFolderHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="SettingsExportFolderLabel" Margin="0,8,0,0" Style="{StaticResource SecondaryTextBlockStyle}" />
                    <TextBlock FontFamily="{StaticResource PathFontFamily}" FontSize="13" Text="{x:Bind ViewModel.ExportFolder, Mode=OneWay}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="SettingsExportFolderChange" Command="{x:Bind ViewModel.ChangeExportFolderCommand}" />
                        <Button x:Uid="SettingsExportFolderDefault" Command="{x:Bind ViewModel.UseDefaultExportFolderCommand}" />
                    </StackPanel>
                    <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.HasFolderProblem, Mode=OneWay}" Severity="Warning" Message="{x:Bind ViewModel.FolderProblem, Mode=OneWay, Converter={StaticResource ResourceString}, ConverterParameter=FolderProblem}" />
                    <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.HasFolderError, Mode=OneWay}" Severity="Error" x:Uid="SettingsFolderError" Message="{x:Bind ViewModel.FolderError, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsExclusionsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsExclusionsHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="SettingsExclusionBox" FontFamily="{StaticResource PathFontFamily}" Text="{x:Bind ViewModel.NewExclusion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Uid="SettingsExclusionAdd" Grid.Column="1" Command="{x:Bind ViewModel.AddExclusionCommand}" />
                    </Grid>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Exclusions}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid Padding="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource PathFontFamily}" FontSize="13" Text="{x:Bind}" TextTrimming="CharacterEllipsis" />
                                    <Button x:Uid="SettingsExclusionRemove" Grid.Column="1" Click="OnRemoveExclusion" Tag="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <RadioButtons x:Uid="SettingsTheme" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <RadioButton x:Uid="SettingsThemeLight" />
                    <RadioButton x:Uid="SettingsThemeDark" />
                    <RadioButton x:Uid="SettingsThemeColorful" />
                </RadioButtons>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsLogsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock FontFamily="{StaticResource PathFontFamily}" FontSize="13" Text="{x:Bind ViewModel.LogsFolder}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="SettingsLogsHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="SettingsLogsOpen" Click="OnOpenLogs" />
                        <Button x:Uid="SettingsLogsExport" Command="{x:Bind ViewModel.ExportLogsCommand}" />
                    </StackPanel>
                    <TextBlock x:Uid="SettingsLogsExportHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.HasExport, Mode=OneWay}" Severity="Success" x:Uid="SettingsLogsExported" Message="{x:Bind ViewModel.ExportedPath, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button x:Uid="SettingsLogsReveal" Command="{x:Bind ViewModel.RevealExportCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.ExportFailed, Mode=OneWay}" Severity="Error" x:Uid="SettingsLogsExportFailed" Message="{x:Bind ViewModel.ExportError, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="48" Height="48" Source="ms-appx:///Assets/cleanslate.ico" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Uid="SettingsAboutTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryTextBlockStyle}">
                            <Run x:Uid="SettingsAboutEngine" />
                            <Run Text="{x:Bind ViewModel.EngineVersion, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock x:Uid="SettingsAboutLicense" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
