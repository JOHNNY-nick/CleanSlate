<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanSlate.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock x:Uid="SettingsTitle" Style="{StaticResource PageTitleTextBlockStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Uid="SettingsSimulation" IsOn="{x:Bind ViewModel.SimulationMode, Mode=TwoWay}" />
                    <TextBlock x:Uid="SettingsSimulationHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <NumberBox x:Uid="SettingsQuarantineDays" Maximum="365" Minimum="1" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.QuarantineDays, Mode=TwoWay}" />
                    <TextBlock x:Uid="SettingsQuarantineHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsExclusionsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsExclusionsHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="SettingsExclusionBox" FontFamily="{StaticResource PathFontFamily}" Text="{x:Bind ViewModel.NewExclusion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Uid="SettingsExclusionAdd" Grid.Column="1" Command="{x:Bind ViewModel.AddExclusionCommand}" />
                    </Grid>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Exclusions}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid Padding="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource PathFontFamily}" FontSize="13" Text="{x:Bind}" TextTrimming="CharacterEllipsis" />
                                    <Button x:Uid="SettingsExclusionRemove" Grid.Column="1" Click="OnRemoveExclusion" Tag="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <RadioButtons x:Uid="SettingsTheme" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <RadioButton x:Uid="SettingsThemeSystem" />
                    <RadioButton x:Uid="SettingsThemeLight" />
                    <RadioButton x:Uid="SettingsThemeDark" />
                </RadioButtons>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsLogsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock FontFamily="{StaticResource PathFontFamily}" FontSize="13" Text="{x:Bind ViewModel.LogsFolder}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="SettingsLogsHelp" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    <Button x:Uid="SettingsLogsOpen" Click="OnOpenLogs" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="48" Height="48" Source="ms-appx:///Assets/cleanslate.ico" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Uid="SettingsAboutTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryTextBlockStyle}">
                            <Run x:Uid="SettingsAboutEngine" />
                            <Run Text="{x:Bind ViewModel.EngineVersion, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock x:Uid="SettingsAboutLicense" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
