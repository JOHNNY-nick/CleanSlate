<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanSlate.App.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CleanSlate.App.Converters"
    xmlns:vm="using:CleanSlate.Presentation.ViewModels"
    Loaded="OnLoaded">

    <Page.Resources>
        <conv:ResourceStringConverter x:Key="ResourceString" />
    </Page.Resources>

    <Grid Margin="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and count -->
        <StackPanel Spacing="2">
            <TextBlock x:Uid="AppsTitle" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource TextPrimaryBrush}" />
            <TextBlock Style="{StaticResource SecondaryTextBlockStyle}">
                <Run Text="{x:Bind ViewModel.VisibleCount, Mode=OneWay}" />
                <Run x:Uid="AppsCountSuffix" />
            </TextBlock>
        </StackPanel>

        <!-- Search, sort, system filter -->
        <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox
                x:Uid="AppsSearch"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock x:Uid="AppsKindLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                <ComboBox x:Uid="AppsKind" MinWidth="110" SelectedIndex="{x:Bind ViewModel.KindFilterIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="AppsKindAll" />
                    <ComboBoxItem x:Uid="AppsKindWin32" />
                    <ComboBoxItem x:Uid="AppsKindStore" />
                </ComboBox>
                <TextBlock x:Uid="AppsSortLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                <ComboBox x:Uid="AppsSort" MinWidth="150" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="AppsSortName" />
                    <ComboBoxItem x:Uid="AppsSortSize" />
                    <ComboBoxItem x:Uid="AppsSortDate" />
                </ComboBox>
            </StackPanel>
            <CheckBox
                x:Uid="AppsShowSystem"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                IsChecked="{x:Bind ViewModel.ShowSystemComponents, Mode=TwoWay}" />
        </Grid>

        <!-- Column headers -->
        <Grid Grid.Row="2" Padding="16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="AppsColName" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
            <TextBlock x:Uid="AppsColPublisher" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
            <TextBlock x:Uid="AppsColVersion" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
            <TextBlock x:Uid="AppsColSize" Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
            <TextBlock x:Uid="AppsColDate" Grid.Column="4" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
        </Grid>

        <!-- Virtualized list -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <ListView
                    x:Name="AppsList"
                    x:Uid="AppsList"
                    ItemsSource="{x:Bind ViewModel.Apps}"
                    SelectedItem="{x:Bind ViewModel.SelectedApp, Mode=OneWay}"
                    SelectionChanged="OnSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppItemViewModel">
                            <Grid Padding="0,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="4" Background="{ThemeResource AccentSubtleBrush}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentBrush}"
                                            Text="{x:Bind Initials}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind DisplayName}" />
                                    <Border
                                        Grid.Column="2"
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentSubtleBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind IsStore}">
                                        <TextBlock x:Uid="AppsStoreBadge" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind PublisherText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind VersionText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind SizeText}" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind DateText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    x:Uid="AppsEmpty"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryTextBlockStyle}"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                <InfoBar
                    x:Uid="AppsLoadError"
                    Margin="16"
                    VerticalAlignment="Top"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorDetails, Mode=OneWay}"
                    Severity="Error" />
            </Grid>
        </Border>

        <!-- Action bar of the selected application -->
        <Border
            Grid.Row="4"
            Style="{StaticResource CardBorderStyle}"
            Padding="16,12"
            Background="{ThemeResource AccentSubtleBrush}"
            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind ViewModel.SelectedApp.DisplayName, Mode=OneWay, FallbackValue=''}" />
                        <Run x:Uid="AppsSelectedSuffix" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Uid="AppsFolderLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock
                            FontFamily="{StaticResource PathFontFamily}"
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="{x:Bind ViewModel.SelectedApp.LocationText, Mode=OneWay, FallbackValue=''}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ViewModel.SelectedApp.HasInstallerName, Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBlock x:Uid="AppsInstallerLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedApp.InstallerName, Mode=OneWay, FallbackValue=''}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{x:Bind ViewModel.SelectedApp.HiddenReasonKey, Mode=OneWay, Converter={StaticResource ResourceString}, ConverterParameter=HiddenReason, FallbackValue=''}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.SelectedApp.IsProtectedStore, Mode=OneWay, FallbackValue=Collapsed}" />
                </StackPanel>
                <Button
                    x:Uid="AppsClassicUninstall"
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.ClassicUninstallCommand}" />
                <Button
                    x:Uid="AppsUninstallCompletely"
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.UninstallCompletelyCommand}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
