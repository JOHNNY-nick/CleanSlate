<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanSlate.App.Views.OrphansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CleanSlate.App.Converters"
    xmlns:vm="using:CleanSlate.Presentation.ViewModels">

    <Page.Resources>
        <conv:ResourceStringConverter x:Key="ResourceString" />
        <conv:ConfidenceBrushConverter x:Key="ConfidenceBrush" />
    </Page.Resources>

    <Grid Margin="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title, summary and scan button -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <Border Style="{StaticResource PageHeaderBorderStyle}" Background="{ThemeResource PageHeaderOrphansBrush}">
                    <TextBlock x:Uid="OrphansTitle" Style="{StaticResource PageHeaderTextBlockStyle}" />
                </Border>
                <TextBlock Style="{StaticResource SecondaryTextBlockStyle}" Visibility="{x:Bind ViewModel.HasScanned, Mode=OneWay}">
                    <Run x:Uid="OrphansSummaryDate" />
                    <Run Text="{x:Bind ViewModel.ScanDateText, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}" />
                    <Run Text="s ·" />
                    <Run Text="{x:Bind ViewModel.GroupCount, Mode=OneWay}" />
                    <Run x:Uid="OrphansSummaryGroups" />
                    <Run Text="·" />
                    <Run Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button
                    x:Uid="OrphansScan"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    Style="{StaticResource MainButtonStyle}" />
                <!-- Task 3 (D78): how the confidence of a leftover is computed, in a « ? » (owner, 4 Nov. 2026). -->
                <Button x:Uid="OrphansHelp" Width="40" Height="40" Padding="0" VerticalAlignment="Center" CornerRadius="20">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="?" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <ScrollViewer MaxHeight="520">
                                <StackPanel Width="420" Spacing="10">
                                    <TextBlock x:Uid="OrphansConfidenceHelpTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="OrphansConfidenceHelpText" Foreground="{ThemeResource TextPrimaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Progress (EF-11) -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="OrphansProgressLabel" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock x:Name="ProgressAnnouncement" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextPrimaryBrush}" Text="{x:Bind ViewModel.ProgressAnnouncement, Mode=OneWay}" />
                </StackPanel>
                <ProgressBar
                    x:Uid="OrphansProgressBar"
                    Grid.Row="1"
                    IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                    Maximum="100"
                    Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="2"
                    FontFamily="{StaticResource PathFontFamily}"
                    FontSize="12"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Text="{x:Bind ViewModel.ProgressPath, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Button x:Uid="OrphansCancel" Grid.RowSpan="3" Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.ScanCancelCommand}" />
            </Grid>
        </Border>

        <!-- Messages and confidence filter -->
        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar x:Uid="OrphansEngineError" IsClosable="False" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorDetails, Mode=OneWay}" Severity="Error" />
            <InfoBar x:Uid="OrphansCancelled" IsClosable="False" IsOpen="{x:Bind ViewModel.WasCancelled, Mode=OneWay}" Severity="Warning">
                <InfoBar.ActionButton>
                    <Button x:Uid="OrphansRescan" Command="{x:Bind ViewModel.ScanCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasItemErrors, Mode=OneWay}"
                Message="{x:Bind conv:Texts.One('Format_AccessDenied', ViewModel.ErrorCount), Mode=OneWay}"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Uid="OrphansErrorDetails" Command="{x:Bind ViewModel.ToggleItemErrorsCommand}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <ScrollViewer
                        MaxHeight="160"
                        Margin="0,0,0,12"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        Visibility="{x:Bind ViewModel.ShowItemErrors, Mode=OneWay}">
                        <ItemsControl x:Uid="OrphansErrorList" FontFamily="{StaticResource PathFontFamily}" FontSize="12" ItemsSource="{x:Bind ViewModel.ItemErrors}" />
                    </ScrollViewer>
                </InfoBar.Content>
            </InfoBar>
            <RadioButtons
                x:Uid="OrphansFilter"
                MaxColumns="4"
                SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasScanned, Mode=OneWay}">
                <RadioButton x:Uid="OrphansFilterAll" />
                <RadioButton x:Uid="OrphansFilterHigh" />
                <RadioButton x:Uid="OrphansFilterMedium" />
                <RadioButton x:Uid="OrphansFilterLow" />
            </RadioButtons>
        </StackPanel>

        <!-- Groups -->
        <Grid Grid.Row="3">
            <ListView
                x:Uid="OrphansGroups"
                ItemsSource="{x:Bind ViewModel.VisibleGroups}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LeftoverGroupViewModel">
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                            Visibility="{x:Bind IsVisible, Mode=OneWay}">
                            <Expander.Header>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Padding="0,8" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}">
                                            <Run x:Uid="OrphansProbably" />
                                            <Run Text="{x:Bind Label}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}">
                                            <Run Text="{x:Bind PublisherPrefix}" />
                                            <Run Text="{x:Bind ItemCount}" />
                                            <Run x:Uid="OrphansItems" />
                                            <Run Text="·" />
                                            <Run Text="{x:Bind TotalText}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- Best confidence of the group, readable folded: colored badge and its word. -->
                                    <Border
                                        Grid.Column="1"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind TopConfidence, Converter={StaticResource ConfidenceBrush}, ConverterParameter=Background}"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind TopConfidence, Converter={StaticResource ConfidenceBrush}, ConverterParameter=Foreground}"
                                            Text="{x:Bind TopConfidence, Converter={StaticResource ResourceString}, ConverterParameter=Confidence}" />
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <ItemsRepeater ItemsSource="{x:Bind Items}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LeftoverItemViewModel">
                                        <Grid Padding="0,6" ColumnSpacing="12" Visibility="{x:Bind IsVisible, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                MinWidth="0"
                                                AutomationProperties.Name="{x:Bind AutomationName}"
                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind Kind, Converter={StaticResource ResourceString}, ConverterParameter=Kind}" />
                                                <TextBlock FontFamily="{StaticResource PathFontFamily}" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" Text="{x:Bind Location}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Location}" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind ReasonsText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind SizeText}" />
                                            <Border
                                                Grid.Column="3"
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Background="{x:Bind Confidence, Converter={StaticResource ConfidenceBrush}, ConverterParameter=Background}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind Confidence, Converter={StaticResource ConfidenceBrush}, ConverterParameter=Foreground}"
                                                    Text="{x:Bind Confidence, Converter={StaticResource ResourceString}, ConverterParameter=Confidence}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Expander>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.ShowIntro, Mode=OneWay}">
                <TextBlock x:Uid="OrphansIntro" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}">
                <TextBlock x:Uid="OrphansEmpty" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Uid="OrphansGoHome" HorizontalAlignment="Center" Command="{x:Bind ViewModel.GoHomeCommand}" />
            </StackPanel>
        </Grid>

        <!-- Selection bar -->
        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="16,12" Visibility="{x:Bind ViewModel.HasScanned, Mode=OneWay}">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}">
                    <Run Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" />
                    <Run x:Uid="OrphansSelected" />
                    <Run Text="·" />
                    <Run Text="{x:Bind ViewModel.SelectedSizeText, Mode=OneWay}" />
                </TextBlock>
                <!-- The label says what will happen: quarantine or deletion for good (D67). -->
                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="{x:Bind ViewModel.ActionKey, Mode=OneWay, Converter={StaticResource ResourceString}, ConverterParameter=Action}"
                    Command="{x:Bind ViewModel.QuarantineCommand}"
                    Style="{StaticResource DangerButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE74D;" />
                        <TextBlock Text="{x:Bind ViewModel.ActionKey, Mode=OneWay, Converter={StaticResource ResourceString}, ConverterParameter=Action}" />
                    </StackPanel>
                </Button>
                <!-- Task 2: progress of the quarantine, item by item. -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="4" Visibility="{x:Bind ViewModel.CleanProgress.IsActive, Mode=OneWay}">
                    <ProgressBar x:Uid="CleanProgressBar" Maximum="100" Value="{x:Bind ViewModel.CleanProgress.Percent, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SecondaryTextBlockStyle}" Text="{x:Bind ViewModel.CleanProgress.Text, Mode=OneWay}" />
                    <TextBlock FontFamily="{StaticResource PathFontFamily}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind ViewModel.CleanProgress.Current, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="4" Visibility="{x:Bind ViewModel.ShowCleanResult, Mode=OneWay}">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasCleaned, Mode=OneWay}"
                        Message="{x:Bind conv:Texts.Two(ViewModel.CleanedFormatKey, ViewModel.CleanedCount, ViewModel.CleanedSizeText), Mode=OneWay}"
                        Severity="Success" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasPendingReboot, Mode=OneWay}"
                        Message="{x:Bind conv:Texts.One('Format_PendingReboot', ViewModel.PendingRebootCount), Mode=OneWay}"
                        Severity="Warning">
                        <InfoBar.ActionButton>
                            <Button x:Uid="OrphansSeeFiles" Command="{x:Bind ViewModel.OpenHistoryCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasCleanFailures, Mode=OneWay}"
                        Message="{x:Bind conv:Texts.One('Format_CleanFailures', ViewModel.CleanFailureCount), Mode=OneWay}"
                        Severity="Warning" />
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Page>
