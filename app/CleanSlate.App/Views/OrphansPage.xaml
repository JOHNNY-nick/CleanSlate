<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanSlate.App.Views.OrphansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CleanSlate.App.Converters"
    xmlns:vm="using:CleanSlate.Presentation.ViewModels">

    <Page.Resources>
        <conv:ResourceStringConverter x:Key="ResourceString" />
        <conv:ConfidenceBrushConverter x:Key="ConfidenceBrush" />
    </Page.Resources>

    <Grid Margin="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title, summary and scan button -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Uid="OrphansTitle" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Style="{StaticResource SecondaryTextBlockStyle}" Visibility="{x:Bind ViewModel.HasScanned, Mode=OneWay}">
                    <Run x:Uid="OrphansSummaryDate" />
                    <Run Text="{x:Bind ViewModel.ScanDateText, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}" />
                    <Run Text="s ·" />
                    <Run Text="{x:Bind ViewModel.GroupCount, Mode=OneWay}" />
                    <Run x:Uid="OrphansSummaryGroups" />
                    <Run Text="·" />
                    <Run Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <Button
                x:Uid="OrphansScan"
                Grid.Column="1"
                VerticalAlignment="Top"
                Command="{x:Bind ViewModel.ScanCommand}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!-- Progress (EF-11) -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="OrphansProgressLabel" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock x:Name="ProgressAnnouncement" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextPrimaryBrush}" Text="{x:Bind ViewModel.ProgressAnnouncement, Mode=OneWay}" />
                </StackPanel>
                <ProgressBar
                    x:Uid="OrphansProgressBar"
                    Grid.Row="1"
                    IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                    Maximum="100"
                    Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="2"
                    FontFamily="{StaticResource PathFontFamily}"
                    FontSize="12"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Text="{x:Bind ViewModel.ProgressPath, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Button x:Uid="OrphansCancel" Grid.RowSpan="3" Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.ScanCancelCommand}" />
            </Grid>
        </Border>

        <!-- Messages and confidence filter -->
        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar x:Uid="OrphansEngineError" IsClosable="False" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorDetails, Mode=OneWay}" Severity="Error" />
            <InfoBar x:Uid="OrphansCancelled" IsClosable="False" IsOpen="{x:Bind ViewModel.WasCancelled, Mode=OneWay}" Severity="Warning">
                <InfoBar.ActionButton>
                    <Button x:Uid="OrphansRescan" Command="{x:Bind ViewModel.ScanCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.HasItemErrors, Mode=OneWay}" Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Uid="OrphansErrorDetails" Command="{x:Bind ViewModel.ToggleItemErrorsCommand}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <StackPanel Margin="0,0,0,12" Spacing="8">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{x:Bind ViewModel.ErrorCount, Mode=OneWay}" />
                            <Run x:Uid="OrphansAccessDenied" />
                        </TextBlock>
                        <ScrollViewer MaxHeight="160" Visibility="{x:Bind ViewModel.ShowItemErrors, Mode=OneWay}">
                            <ItemsControl x:Uid="OrphansErrorList" FontFamily="{StaticResource PathFontFamily}" FontSize="12" ItemsSource="{x:Bind ViewModel.ItemErrors}" />
                        </ScrollViewer>
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
            <RadioButtons
                x:Uid="OrphansFilter"
                MaxColumns="4"
                SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasScanned, Mode=OneWay}">
                <RadioButton x:Uid="OrphansFilterAll" />
                <RadioButton x:Uid="OrphansFilterHigh" />
                <RadioButton x:Uid="OrphansFilterMedium" />
                <RadioButton x:Uid="OrphansFilterLow" />
            </RadioButtons>
        </StackPanel>

        <!-- Groups -->
        <Grid Grid.Row="3">
            <ListView
                x:Uid="OrphansGroups"
                ItemsSource="{x:Bind ViewModel.Groups}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LeftoverGroupViewModel">
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                            Visibility="{x:Bind IsVisible, Mode=OneWay}">
                            <Expander.Header>
                                <StackPanel Padding="0,8" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}">
                                        <Run x:Uid="OrphansProbably" />
                                        <Run Text="{x:Bind Label}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}">
                                        <Run Text="{x:Bind PublisherPrefix}" />
                                        <Run Text="{x:Bind ItemCount}" />
                                        <Run x:Uid="OrphansItems" />
                                        <Run Text="·" />
                                        <Run Text="{x:Bind TotalText}" />
                                    </TextBlock>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsRepeater ItemsSource="{x:Bind Items}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LeftoverItemViewModel">
                                        <Grid Padding="0,6" ColumnSpacing="12" Visibility="{x:Bind IsVisible, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                MinWidth="0"
                                                AutomationProperties.Name="{x:Bind AutomationName}"
                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind Kind, Converter={StaticResource ResourceString}, ConverterParameter=Kind}" />
                                                <TextBlock FontFamily="{StaticResource PathFontFamily}" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" Text="{x:Bind Location}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Location}" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind ReasonsText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind SizeText}" />
                                            <Border
                                                Grid.Column="3"
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Background="{x:Bind Confidence, Converter={StaticResource ConfidenceBrush}, ConverterParameter=Background}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind Confidence, Converter={StaticResource ConfidenceBrush}, ConverterParameter=Foreground}"
                                                    Text="{x:Bind Confidence, Converter={StaticResource ResourceString}, ConverterParameter=Confidence}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Expander>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.ShowIntro, Mode=OneWay}">
                <TextBlock x:Uid="OrphansIntro" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}">
                <TextBlock x:Uid="OrphansEmpty" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Uid="OrphansGoHome" HorizontalAlignment="Center" Command="{x:Bind ViewModel.GoHomeCommand}" />
            </StackPanel>
        </Grid>

        <!-- Selection bar -->
        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="16,12" Visibility="{x:Bind ViewModel.HasScanned, Mode=OneWay}">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}">
                    <Run Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" />
                    <Run x:Uid="OrphansSelected" />
                    <Run Text="·" />
                    <Run Text="{x:Bind ViewModel.SelectedSizeText, Mode=OneWay}" />
                </TextBlock>
                <Button x:Uid="OrphansSimulate" Grid.Column="1" Command="{x:Bind ViewModel.SimulateCommand}" />
                <Button
                    x:Uid="OrphansQuarantine"
                    Grid.Column="2"
                    Background="{ThemeResource DangerBrush}"
                    Command="{x:Bind ViewModel.QuarantineCommand}"
                    Foreground="White" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="4" Visibility="{x:Bind ViewModel.ShowCleanResult, Mode=OneWay}">
                    <InfoBar IsClosable="False" IsOpen="True" Severity="Success">
                        <InfoBar.Content>
                            <TextBlock Margin="0,0,0,12" TextWrapping="Wrap">
                                <Run Text="{x:Bind ViewModel.CleanedCount, Mode=OneWay}" />
                                <Run x:Uid="OrphansCleanedMiddle" />
                                <Run Text="{x:Bind ViewModel.CleanedSizeText, Mode=OneWay}" /><Run x:Uid="OrphansCleanedSuffix" />
                            </TextBlock>
                        </InfoBar.Content>
                    </InfoBar>
                    <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.HasPendingReboot, Mode=OneWay}" Severity="Warning">
                        <InfoBar.ActionButton>
                            <Button x:Uid="OrphansSeeFiles" Command="{x:Bind ViewModel.OpenHistoryCommand}" />
                        </InfoBar.ActionButton>
                        <InfoBar.Content>
                            <TextBlock Margin="0,0,0,12" TextWrapping="Wrap">
                                <Run Text="{x:Bind ViewModel.PendingRebootCount, Mode=OneWay}" />
                                <Run x:Uid="OrphansPendingReboot" />
                            </TextBlock>
                        </InfoBar.Content>
                    </InfoBar>
                    <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.HasCleanFailures, Mode=OneWay}" Severity="Warning">
                        <InfoBar.Content>
                            <TextBlock Margin="0,0,0,12" TextWrapping="Wrap">
                                <Run Text="{x:Bind ViewModel.CleanFailureCount, Mode=OneWay}" />
                                <Run x:Uid="OrphansCleanFailures" />
                            </TextBlock>
                        </InfoBar.Content>
                    </InfoBar>
                </StackPanel>
                <InfoBar Grid.Row="1" Grid.ColumnSpan="3" IsClosable="False" IsOpen="{x:Bind ViewModel.ShowSimulation, Mode=OneWay}" Severity="Success">
                    <InfoBar.ActionButton>
                        <Button x:Uid="OrphansDisableSimulation" Command="{x:Bind ViewModel.OpenSettingsCommand}" Visibility="{x:Bind ViewModel.IsSimulationMode}" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap">
                            <Run x:Uid="OrphansSimulationPrefix" />
                            <Run Text="{x:Bind ViewModel.SimulatedCount, Mode=OneWay}" />
                            <Run x:Uid="OrphansSimulationMiddle" />
                            <Run Text="{x:Bind ViewModel.SimulatedSizeText, Mode=OneWay}" /><Run Text=")." />
                        </TextBlock>
                    </InfoBar.Content>
                </InfoBar>
            </Grid>
        </Border>
    </Grid>
</Page>
