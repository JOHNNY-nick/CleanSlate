<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CleanSlate.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Design tokens (docs/design.md § 3). Views never hard-code colors. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentBrush" Color="#0F766E" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#115E59" />
                    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E3F2F1" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D1D1D1" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C5C5C" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="ConfidenceHighForegroundBrush" Color="#0E700E" />
                    <SolidColorBrush x:Key="ConfidenceHighBackgroundBrush" Color="#DFF6DD" />
                    <SolidColorBrush x:Key="ConfidenceMediumForegroundBrush" Color="#8A5100" />
                    <SolidColorBrush x:Key="ConfidenceMediumBackgroundBrush" Color="#FFF4CE" />
                    <SolidColorBrush x:Key="ConfidenceLowForegroundBrush" Color="#5C5C5C" />
                    <SolidColorBrush x:Key="ConfidenceLowBackgroundBrush" Color="#EDEDED" />
                    <!-- Accent buttons use the teal tokens instead of the Windows accent. -->
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F766E" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115E59" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#115E59" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
                    <!-- WinUI accent brushes as tokens, so that Multicolore can recolor them (D71). -->
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0F766E" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#14857C" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#115E59" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#115E59" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#0D4D49" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#0F766E" />
                    <!-- Teal accent for every WinUI control (selection, radio buttons…). -->
                    <Color x:Key="SystemAccentColor">#0F766E</Color>
                    <Color x:Key="SystemAccentColorLight1">#14857C</Color>
                    <Color x:Key="SystemAccentColorLight2">#2A9D93</Color>
                    <Color x:Key="SystemAccentColorLight3">#4FB8AD</Color>
                    <Color x:Key="SystemAccentColorDark1">#115E59</Color>
                    <Color x:Key="SystemAccentColorDark2">#0D4D49</Color>
                    <Color x:Key="SystemAccentColorDark3">#0A3D3A</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentBrush" Color="#4FB8AD" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6CCBC1" />
                    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E3A38" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B2B28" />
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#E0473A" />
                    <SolidColorBrush x:Key="ConfidenceHighForegroundBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="ConfidenceHighBackgroundBrush" Color="#393D1B" />
                    <SolidColorBrush x:Key="ConfidenceMediumForegroundBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="ConfidenceMediumBackgroundBrush" Color="#433519" />
                    <SolidColorBrush x:Key="ConfidenceLowForegroundBrush" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="ConfidenceLowBackgroundBrush" Color="#3A3A3A" />
                    <!-- Accent buttons use the teal tokens instead of the Windows accent. -->
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#4FB8AD" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#6CCBC1" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#6CCBC1" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B2B28" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B2B28" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0B2B28" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4FB8AD" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#6CCBC1" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#2A9D93" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#8ED9D1" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#B3E8E2" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#6CCBC1" />
                    <!-- Teal accent for every WinUI control (selection, radio buttons…). -->
                    <Color x:Key="SystemAccentColor">#4FB8AD</Color>
                    <Color x:Key="SystemAccentColorLight1">#6CCBC1</Color>
                    <Color x:Key="SystemAccentColorLight2">#8ED9D1</Color>
                    <Color x:Key="SystemAccentColorLight3">#B3E8E2</Color>
                    <Color x:Key="SystemAccentColorDark1">#2A9D93</Color>
                    <Color x:Key="SystemAccentColorDark2">#14857C</Color>
                    <Color x:Key="SystemAccentColorDark3">#0F766E</Color>
                </ResourceDictionary>
                <!-- High contrast: tokens follow the Windows contrast theme (design § 6). -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ConfidenceHighForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ConfidenceHighBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ConfidenceMediumForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ConfidenceMediumBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ConfidenceLowForegroundBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="ConfidenceLowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                Multicolore theme (D71): the light tokens recolored with the book's palette
                (book/book.css). Applied by MainWindow.ApplyTheme; contrasts checked by ThemeTests.
            -->
            <ResourceDictionary x:Key="ColorfulPalette">
                <Color x:Key="AccentBrush">#6C4DFF</Color>
                <Color x:Key="AccentHoverBrush">#4B2FD6</Color>
                <Color x:Key="AccentSubtleBrush">#EFEBFF</Color>
                <Color x:Key="OnAccentBrush">#FFFFFF</Color>
                <Color x:Key="WindowBackgroundBrush">#EAE5FF</Color>
                <Color x:Key="SurfaceBrush">#FFFFFF</Color>
                <Color x:Key="BorderBrush">#DCD6F7</Color>
                <Color x:Key="ControlBorderBrush">#C9C1F0</Color>
                <Color x:Key="TextPrimaryBrush">#1B1740</Color>
                <Color x:Key="TextSecondaryBrush">#5E5B78</Color>
                <Color x:Key="DangerBrush">#C81D25</Color>
                <Color x:Key="ConfidenceHighForegroundBrush">#0F6E4B</Color>
                <Color x:Key="ConfidenceHighBackgroundBrush">#DDF3E9</Color>
                <Color x:Key="ConfidenceMediumForegroundBrush">#C2185B</Color>
                <Color x:Key="ConfidenceMediumBackgroundBrush">#FFE0EA</Color>
                <Color x:Key="ConfidenceLowForegroundBrush">#5A5680</Color>
                <Color x:Key="ConfidenceLowBackgroundBrush">#ECEFF4</Color>
                <Color x:Key="AccentButtonBackground">#6C4DFF</Color>
                <Color x:Key="AccentButtonBackgroundPointerOver">#4B2FD6</Color>
                <Color x:Key="AccentButtonBackgroundPressed">#4B2FD6</Color>
                <Color x:Key="AccentButtonForeground">#FFFFFF</Color>
                <Color x:Key="AccentButtonForegroundPointerOver">#FFFFFF</Color>
                <Color x:Key="AccentButtonForegroundPressed">#FFFFFF</Color>
                <Color x:Key="AccentFillColorDefaultBrush">#6C4DFF</Color>
                <Color x:Key="AccentFillColorSecondaryBrush">#7A5DFF</Color>
                <Color x:Key="AccentFillColorTertiaryBrush">#4B2FD6</Color>
                <Color x:Key="AccentTextFillColorPrimaryBrush">#4B2FD6</Color>
                <Color x:Key="AccentTextFillColorSecondaryBrush">#3A22AE</Color>
                <Color x:Key="AccentTextFillColorTertiaryBrush">#6C4DFF</Color>
            </ResourceDictionary>
            <!-- Shapes and spacing (docs/design.md § 3). -->
            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
            <Thickness x:Key="PageMargin">40,24,40,24</Thickness>
            <FontFamily x:Key="PathFontFamily">Cascadia Mono</FontFamily>

            <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="SecondaryTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="24" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
