                <Color x:Key="ContentSurfaceBrush">#00000000</Color>
                <Color x:Key="PaneBackgroundBrush">#00000000</Color>
                <Color x:Key="StorageApplicationsBrush">#159CE8</Color>
                <Color x:Key="StorageLeftoversBrush">#FF8B16</Color>
                <Color x:Key="StorageQuarantineBrush">#B36BF5</Color>
                <Color x:Key="StorageUserFilesBrush">#42D62B</Color>
                <Color x:Key="StorageSystemBrush">#16C9C2</Color>
                <Color x:Key="StorageOtherBrush">#FFDF18</Color>
                <Color x:Key="StorageTileTextBrush">#070A14</Color>
                <Color x:Key="Paint0">#E53935</Color>
                <Color x:Key="Paint1">#FF8B16</Color>
                <Color x:Key="Paint2">#FFDF18</Color>
                <Color x:Key="Paint3">#42D62B</Color>
                <Color x:Key="Paint4">#159CE8</Color>
                <Color x:Key="Paint5">#9638ED</Color>
                <Color x:Key="Paint6">#FF3994</Color>
                <Color x:Key="Paint7">#16C9C2</Color>
                <Color x:Key="PaintSurfaceColor">#FF1E2333</Color>
                <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
                <!-- Street style (D76) on a dark wall. -->
                <Color x:Key="Ink">#070A14</Color>
                <Color x:Key="NavActiveColor">#2E7D1E</Color>
                <Color x:Key="NavActiveBorderColor">#7CF25A</Color>
                <Color x:Key="NavActiveTextColor">#FFFFFF</Color>
                <!-- Labels of the map and session states: light stickers with ink text, in both modes. -->
                <Color x:Key="LabelStickerColor">#F2FFFDF7</Color>
                <Color x:Key="StatusCompletedColor">#B9FF82</Color>
                <Color x:Key="StatusPartialColor">#FFE76A</Color>
                <Color x:Key="StatusRestoredColor">#9FE3FF</Color>
                <Color x:Key="StatusPurgedColor">#FFB3D1</Color>
                <Color x:Key="PageHeaderManagerBrush">#FFDF18</Color>
            </ResourceDictionary>
            <!-- Shapes and spacing (docs/design.md § 3). -->
            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
            <Thickness x:Key="PageMargin">40,24,40,24</Thickness>
            <FontFamily x:Key="PathFontFamily">Cascadia Mono</FontFamily>

            <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TitleBrush}" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <!-- Page header: a colored band in Multicolore, invisible in the other themes (D72). -->
            <Style x:Key="PageHeaderBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource PageHeaderStripBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10,16,10" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="PageHeaderTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource PageHeaderForegroundBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!--
                Buttons that move or delete (EF-16, D72): plain dark red, white bold label, an
                icon and a dark outline, so that they never pass for the decorative reds.
            -->
            <!--
                Main action of a page: the WinUI accent button, under a name of CleanSlate so that
                Multicolore can find it and paint it green with an ink outline (D76).
            -->
            <Style x:Key="MainButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}" />
            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource DangerBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource OnDangerBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,6,14,6" />
            </Style>
            <Style x:Key="SecondaryTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource CardBorderThickness}" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="24" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
