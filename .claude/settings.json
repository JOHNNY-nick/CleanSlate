{
  "permissions": {
    "deny": [
      "Bash(*cleanslate-cli.exe sandbox*)",
      "Bash(*cleanslate-cli.exe\" sandbox*)",
      "Bash(*cleanslate-cli-sandbox.exe *)",
      "Bash(*-p cleanslate-cli -- sandbox*)",
      "PowerShell(*cleanslate-cli.exe sandbox*)",
      "PowerShell(*cleanslate-cli.exe\" sandbox*)",
      "PowerShell(*cleanslate-cli-sandbox.exe *)",
      "PowerShell(*-p cleanslate-cli -- sandbox*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\guard-cleanslate-cli.ps1\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Garde cleanslate-cli (D53)"
          }
        ]
      }
    ]
  }
}
